<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Normal state: current exchange ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/subtitle_normal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Live partial STT text -->
        <TextView
            android:id="@+id/tv_subtitle_partial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#80FFFFFF"
            android:textStyle="italic"
            android:gravity="center"
            android:visibility="gone"
            tools:text="Where is the train…"
            tools:visibility="visible" />

        <!-- Original spoken text -->
        <TextView
            android:id="@+id/tv_subtitle_original"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#99FFFFFF"
            android:gravity="center"
            android:visibility="gone"
            tools:text="Où est la gare ?"
            tools:visibility="visible" />

        <!-- Translated text — the main readable line -->
        <TextView
            android:id="@+id/tv_subtitle_translated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:visibility="gone"
            tools:text="Where is the train station?"
            tools:visibility="visible" />

        <!-- Tap hint shown when history is available -->
        <TextView
            android:id="@+id/tv_subtitle_tap_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="11sp"
            android:textColor="#55FFFFFF"
            android:gravity="center"
            android:text="Tap to see history"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ── Expanded state: scrollable history ─────────────────────────── -->
    <LinearLayout
        android:id="@+id/subtitle_expanded"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/subtitle_history_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tv_subtitle_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#CCFFFFFF"
                android:lineSpacingMultiplier="1.4"
                tools:text="Bonjour !\n→ Hello!\n\nOù est la gare ?\n→ Where is the train station?\n" />

        </ScrollView>

        <TextView
            android:id="@+id/tv_subtitle_collapse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="▼  Close history"
            android:textSize="12sp"
            android:textColor="#80FFFFFF"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</merge>
