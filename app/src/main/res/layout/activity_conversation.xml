<?xml version="1.0" encoding="utf-8"?>
<!--
    Conversation screen:
    ┌───────────────────────────────────────┐
    │ [Disconnect]  [PeerAvatar] ● Connected│  top bar
    ├───────────────────────────────────────┤
    │                                       │
    │        Wave visualizer                │  ~45% height
    │                                       │
    ├───────────────────────────────────────┤
    │  Scrolling dialogue                   │  ~32% height
    │  (name in colour + text, fades up)    │
    ├───────────────────────────────────────┤
    │            ( B mic FAB )              │  bottom centre
    └───────────────────────────────────────┘
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.conversation.ConversationActivity">

    <!-- Guidelines partitioning vertical space -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_wave_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.52" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_dialogue_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.82" />

    <!-- ── Top bar ───────────────────────────────────────────────────────── -->

    <!-- Disconnect pill — top left -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_disconnect"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        android:text="Disconnect"
        android:textColor="@color/text_on_black"
        android:textSize="13sp"
        android:textStyle="bold"
        app:backgroundTint="@color/disconnect_red"
        app:cornerRadius="20dp"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Peer avatar badge — top centre -->
    <com.babelmic.app.ui.widget.AvatarBadgeView
        android:id="@+id/badge_peer_avatar"
        android:layout_width="@dimen/avatar_badge"
        android:layout_height="@dimen/avatar_badge"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Connected dot + label — top right -->
    <LinearLayout
        android:id="@+id/layout_connected_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/v_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_status_dot"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tv_connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected"
            android:textSize="12sp"
            android:textColor="@color/connected_green" />

    </LinearLayout>

    <!-- ── Wave visualizer zone ──────────────────────────────────────────── -->
    <com.babelmic.app.ui.widget.WaveVisualizerView
        android:id="@+id/wave_visualizer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/badge_peer_avatar"
        app:layout_constraintBottom_toTopOf="@id/guide_wave_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Dialogue zone — scrolling, fading upward ──────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_dialogue"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        app:layout_constraintTop_toTopOf="@id/guide_wave_bottom"
        app:layout_constraintBottom_toTopOf="@id/guide_dialogue_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Mic FAB — circular black button with BabelMic logo ────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_mic"
        android:layout_width="@dimen/mic_button_size"
        android:layout_height="@dimen/mic_button_size"
        android:layout_marginBottom="32dp"
        app:icon="@drawable/ic_logo"
        app:iconSize="28dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:backgroundTint="@color/babelmic_black"
        app:cornerRadius="36dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hidden fields kept for programmatic updates -->
    <TextView android:id="@+id/tv_status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
