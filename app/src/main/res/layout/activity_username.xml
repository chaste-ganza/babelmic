<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:paddingHorizontal="32dp">

    <!-- Spacer to push content to upper-centre -->
    <View android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="@dimen/logo_size"
        android:layout_height="@dimen/logo_size"
        android:src="@drawable/ic_logo"
        android:contentDescription="BabelMic logo"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="48dp" />

    <!-- Username input -->
    <EditText
        android:id="@+id/et_username"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:background="@drawable/bg_input_pill"
        android:hint="Username"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:paddingHorizontal="20dp"
        android:inputType="textPersonName"
        android:maxLength="24"
        android:singleLine="true"
        android:imeOptions="actionDone"
        android:layout_marginBottom="16dp" />

    <!-- Confirm button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="Confirm"
        android:textColor="@color/text_on_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/babelmic_primary"
        app:cornerRadius="@dimen/button_corner"
        app:elevation="0dp" />

    <!-- Spacer bottom (larger so content sits at ~40% from top) -->
    <View android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="2" />

</LinearLayout>
