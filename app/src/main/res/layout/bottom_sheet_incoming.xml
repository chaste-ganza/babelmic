<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingHorizontal="24dp"
    android:paddingBottom="40dp">

    <View android:layout_width="40dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp" android:layout_marginBottom="8dp"
        android:background="#CCCCCC" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Incoming connection"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A user sent a connection request"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp" />

    <!-- Avatar row: Peer <<< You (reversed — incoming comes from right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="40dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <com.babelmic.app.ui.widget.AvatarBadgeView
                android:id="@+id/badge_peer_avatar"
                android:layout_width="72dp" android:layout_height="72dp" />
            <TextView android:id="@+id/tv_peer_name"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp"
                tools:text="John" />
        </LinearLayout>

        <!-- Reversed chevrons -->
        <com.babelmic.app.ui.widget.ChevronArrowView
            android:id="@+id/chevron_arrow"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:scaleX="-1" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <com.babelmic.app.ui.widget.AvatarBadgeView
                android:id="@+id/badge_my_avatar"
                android:layout_width="72dp" android:layout_height="72dp" />
            <TextView android:id="@+id/tv_my_name"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp"
                tools:text="You" />
        </LinearLayout>

    </LinearLayout>

    <!-- Revoke + Approve -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/button_height"
        android:orientation="horizontal" android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_revoke"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginEnd="8dp"
            android:text="Revoke"
            android:textColor="@color/button_black_text"
            android:textSize="15sp" android:textStyle="bold"
            app:backgroundTint="@color/button_black_background"
            app:cornerRadius="@dimen/button_corner"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_approve"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:text="Approve"
            android:textColor="@color/button_primary_text"
            android:textSize="15sp" android:textStyle="bold"
            app:backgroundTint="@color/button_primary_background"
            app:cornerRadius="@dimen/button_corner"
            app:elevation="0dp" />

    </LinearLayout>

</LinearLayout>
