<?xml version="1.0" encoding="utf-8"?>
<!-- Avatar identity ring — a circle stroke. Tinted at runtime with the user's chosen colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="4dp" android:color="@color/ring_pink" />
</shape>
