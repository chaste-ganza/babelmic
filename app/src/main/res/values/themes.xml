<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BabelMic" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/babelmic_blue</item>
        <item name="colorPrimaryVariant">@color/babelmic_blue_dark</item>
        <item name="colorOnPrimary">@color/text_on_blue</item>
        <item name="colorSecondary">@color/ring_pink</item>
        <item name="colorOnSecondary">@color/text_on_blue</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Flat buttons: no press-lift shadow and no ripple wave.
             Press feedback comes from the button colour changing instead. -->
        <item name="materialButtonStyle">@style/Widget.BabelMic.Button.Primary</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>

    <!-- Splash / Onboarding — no status bar tint -->
    <style name="Theme.BabelMic.Splash" parent="Theme.BabelMic">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Blue filled pill button -->
    <style name="Widget.BabelMic.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/babelmic_blue</item>
        <item name="android:textColor">@color/text_on_blue</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">28dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Black filled pill button -->
    <style name="Widget.BabelMic.Button.Black" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/babelmic_black</item>
        <item name="android:textColor">@color/text_on_black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">28dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Red pill disconnect -->
    <style name="Widget.BabelMic.Button.Disconnect" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/disconnect_red</item>
        <item name="android:textColor">@color/text_on_blue</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">20dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Circular black mic FAB -->
    <style name="Widget.BabelMic.MicButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/babelmic_black</item>
        <item name="cornerRadius">36dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>
